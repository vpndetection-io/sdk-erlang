%% The integration suite is its own application, depending on the PUBLISHED
%% package rather than on the source next to it. A `{path, "../"}' dep here would
%% quietly turn every assertion below into a second run of the unit suite.
%%
%% scripts/run.sh reads this constraint, asks hex what satisfies it, and skips
%% the whole run with a reason when nothing does.
{deps, [{vpndetection, "~> 1.0"}]}.

{erl_opts, [debug_info, warnings_as_errors]}.

{eunit_opts, [verbose]}.
